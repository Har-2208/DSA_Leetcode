int searchInsert(int* nums, int numsSize, int target) {
    int h = numsSize-1;
    int l = 0;
    int m;

    while(l <= h){
        m = l + (h-l)/2;

        if(target == nums[m]){
            return m;
        }
        else if(target < nums[m]){
            h = m-1;
        }
        else if(target > nums[m]){
            l = m+1;
        }
    }

    return l;

}