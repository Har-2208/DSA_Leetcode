int findPeakElement(int* nums, int numsSize) {
    int low = 1;
    int high = numsSize-2;
    int mid;

    if(numsSize == 1){
        return 0;
    }
        if(nums[0]>nums[1]){
        return 0;
    }

    if(nums[numsSize-1]>nums[numsSize-2]){
        return numsSize-1;
    }

    while(low<=high){
        mid = (low+high)/2;
        
        if(nums[mid]>nums[mid-1] && nums[mid]>nums[mid+1]){
            return mid;
        }

        if(nums[mid-1]<nums[mid]){
            low = mid + 1;
        }
        else{
            high = mid - 1;
        }
    }

    return -1;
}