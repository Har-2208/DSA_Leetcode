class Solution {
public:

    int fill(vector<int>& weights, int cap){
        int days = 1;
        int load = 0;

        for(int i=0; i<weights.size(); i++){
            if(load+weights[i] > cap){
                days = days+1;
                load = weights[i];
            }
            else{
                load += weights[i];
            }
        }

        return days;
    }

    int shipWithinDays(vector<int>& weights, int days) {
        int low = *max_element(weights.begin(), weights.end());  
        int high = accumulate(weights.begin(), weights.end(), 0);
        int mid;
        int noOfDays;

        while (low<=high){
            mid = (low+high)/2;
            noOfDays = fill(weights, mid);

            if(noOfDays <= days){
                high = mid-1;
            }
            else{
                low = mid+1;
            }
        }     

        return low;  
        
    }
};