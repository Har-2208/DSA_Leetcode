int search(int* a, int numsSize, int target) {
    int low = 0;
    int high = numsSize - 1;

    while(low<=high){
        int mid = (low+high)/2;

        if(a[mid]==target){
            return mid;
        }

        if(a[low] <= a[mid]){
            if(a[low] <= target && a[mid] >= target){
                high = mid - 1;
            }
            else{
                low = mid + 1;
            }
        }
        else{
            if(a[high]>=target && a[mid]<=target){
                low = mid + 1;
            }
            else{
                high = mid - 1;
            }
        }
    }

    return -1;
}